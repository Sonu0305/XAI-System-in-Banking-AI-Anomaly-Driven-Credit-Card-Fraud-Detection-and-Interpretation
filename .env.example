# Kaggle API Credentials Configuration
# Option 1: Path to Kaggle access token file (supported by Kaggle API v2 / KGAT tokens)
KAGGLE_TOKEN_PATH=~/.kaggle/access_token

# Option 2: Legacy Kaggle API Key pair (from kaggle.json)
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key

# Runtime Settings
DEVICE=auto
RANDOM_SEED=42
DATA_DIR=data

